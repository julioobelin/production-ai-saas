ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/knowledge
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRE_MINUTES=30

# Leave the key empty to use the deterministic grounded provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Lexical search is the default. A populated embedding key does not switch retrieval.
# Vector search runs only when RETRIEVAL_MODE=vector and the embedding settings are set.
RETRIEVAL_MODE=lexical
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Optional request parameter. Sent only when set, and only if that endpoint accepts it.
# It does not change the database column width.
# EMBEDDING_DIMENSIONS=

RETRIEVAL_LIMIT=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_DOCUMENT_CHARS=50000
LOG_LEVEL=INFO
